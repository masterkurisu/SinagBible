{
  "name": "@sinag-bible/mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:usb": "adb reverse tcp:8081 tcp:8081 && APP_VARIANT=development expo start --dev-client --localhost",
    "build": "tsc --noEmit",
    "android": "APP_VARIANT=development expo run:android --app-id com.sinagbible.app.dev",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && adb shell am start -n com.sinagbible.app.dev/com.sinagbible.app.MainActivity -a android.intent.action.VIEW -d 'sinagbible-dev://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081'",
    "ios": "APP_VARIANT=development expo run:ios",
    "export": "expo export",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:ios": "eas build --platform ios --profile production",
    "release:android": "eas build --platform android --profile production",
    "prepublish:checklist": "node ./scripts/prepublish-checklist.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/charis-sil": "^0.4.0",
    "@expo-google-fonts/crimson-pro": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/eb-garamond": "^0.4.2",
    "@expo-google-fonts/gentium-plus": "^0.4.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/lato": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/merriweather": "^0.4.2",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo/dom-webview": "~57.0.0",
    "@expo/metro-runtime": "~57.0.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@sinag-bible/core": "workspace:*",
    "@sinag-bible/tokens": "workspace:*",
    "@sinag-bible/types": "workspace:*",
    "@sinag-bible/ui": "workspace:*",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.3",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "^57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-device": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "^57.0.2",
    "expo-image-picker": "^57.0.2",
    "expo-linear-gradient": "^57.0.0",
    "expo-linking": "~57.0.2",
    "expo-media-library": "~57.0.1",
    "expo-print": "~57.0.0",
    "expo-router": "~57.0.4",
    "expo-screen-orientation": "~57.0.0",
    "expo-secure-store": "^57.0.0",
    "expo-sharing": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "^57.0.0",
    "expo-status-bar": "~57.0.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.0",
    "expo-doctor": "^1.18.13",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ],
    "packageExtensions": {
      "@sentry/react-native": {
        "dependencies": {
          "@expo/config-plugins": "~57.0.3"
        }
      }
    }
  }
}
